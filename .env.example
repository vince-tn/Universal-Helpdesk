# Chikiting System - per-deployment settings. Copy to .env and fill in.
#
#   cp .env.example .env
#
# Everything has a working default, so the stack starts with no .env at all.
#
# QUOTE any value containing a space, or a # anywhere in it. CodeIgniter's .env
# parser treats an unquoted # as the start of a comment, so MAIL_PASS=#secret
# silently becomes an EMPTY password, and an unquoted space throws on boot.
#     MAIL_PASS='#secret'          correct
#     MAIL_FROM_NAME='My System'   correct

# ---------------------------------------------------------------- registration
# Who may create their own account, comma separated. Subdomains count.
# LEAVE EMPTY AND THE DOMAIN CHECK IS OFF - anyone can sign up.
# ALLOWED_EMAIL_DOMAINS=kinectinc.com,covau.com.au

# Individual addresses allowed regardless of domain. Still need the emailed code.
# ALLOWED_EMAILS=contractor@gmail.com

# ------------------------------------------------------------------------ mail
# Unset, this uses the Mailpit container - mail is captured at
# http://localhost:8025 and never leaves your machine.
#
# For real delivery, point at any SMTP relay. Office 365 example:
# MAIL_HOST=smtp.office365.com
# MAIL_PORT=587
# MAIL_USER='webform@example.com'
# MAIL_PASS='your-password'
# MAIL_CRYPTO=tls
# MAIL_FROM='webform@example.com'
# MAIL_FROM_NAME='Chikiting System'
#
# Office 365 notes: SMTP AUTH must be enabled on the mailbox (Microsoft
# disables it by default on new tenants), and MAIL_FROM must match MAIL_USER
# or the relay rejects the message.

# -------------------------------------------------------------------- the model
# Ollama runs locally and is the default. Set a Gemini key and big or unmatched
# requests escalate to the cloud model. Free key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# OLLAMA_MODEL=qwen2.5:3b
# GEMINI_MODEL=models/gemini-3.6-flash

# -------------------------------------------------------------------- deploying
# Read by docker-compose.prod.yml, which refuses to start without these.
# APP_URL=http://helpdesk.local/
#
# Behind a free Cloudflare quick tunnel (docker-compose.tunnel.yml), the public
# address is a random *.trycloudflare.com name. This lets the app answer on it:
# PUBLIC_HOST_SUFFIXES=.trycloudflare.com
# MYSQL_PASSWORD=
# MYSQL_ROOT_PASSWORD=

# ALLOWED_EMAIL_DOMAINS=kinectinc.com,covau.com.au
# ALLOWED_EMAILS=contractor@gmail.com

# two-step sign-in secrets are encrypted with encryption.key, or a key derived from the line below
# MFA_KEY=output-of-openssl-rand-hex-32

# microsoft entra id single sign-on, redirect uri is https://<host>/sso/callback
# SSO_TENANT_ID=00000000-0000-0000-0000-000000000000
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# SSO_ALLOWED_DOMAINS=kinectinc.com

# MAIL_HOST=smtp.office365.com
# MAIL_PORT=587
# MAIL_USER='webform@example.com'
# MAIL_PASS='your-password'
# MAIL_CRYPTO=tls
# MAIL_FROM='webform@example.com'
# MAIL_FROM_NAME='Chikiting System'
# TICKET_EMAILS=on

# GEMINI_API_KEY=
# OLLAMA_MODEL=qwen2.5:3b
# GEMINI_MODEL=models/gemini-3.6-flash
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=@preset/autorouter
# OPENROUTER_IMAGE_MODEL=@preset/image-processing
# OPENROUTER_IMAGE_FALLBACKS=inclusionai/ling-3.2-flash:free,google/gemma-4-26b-a4b-it:free

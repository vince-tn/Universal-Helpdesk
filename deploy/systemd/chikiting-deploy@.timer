# Chikiting System - check GitHub for a new tested release of the %i copy
# every minute. See deploy/README.md.

[Unit]
Description=Chikiting System - check for a new %i release every minute

[Timer]
OnBootSec=2min
OnUnitInactiveSec=1min
Unit=chikiting-deploy@%i.service

[Install]
WantedBy=timers.target
